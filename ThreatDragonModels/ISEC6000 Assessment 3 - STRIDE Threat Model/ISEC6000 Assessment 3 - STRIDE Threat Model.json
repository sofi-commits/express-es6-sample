            "data": {
              "type": "tm.Store",
              "name": "Database (PostgreSQL)",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": false,
              "storesInventory": false,
              "threats": [
                {
                  "id": "cdb13d88-76a6-4b7a-85e7-b22fe35059af",
                  "title": "Unauthorized Modification of Database Records",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "If an attacker gains access to the PostgreSQL database (e.g. via a SQL injection vulnerability in the Web Application, or weak database credentials), they could tamper with stored data - modifying, corrupting, or deleting records without authorization.",
                  "mitigation": "Use parameterized queries/an ORM to prevent SQL injection in the Web Application. Store database credentials securely (e.g. AWS Secrets Manager rather than plaintext environment variables in compose files). Restrict database network access to only the application tier (no public exposure), and enable regular automated backups so tampered data can be restored.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": ""
                },
                {
                  "id": "83d820ac-ff10-4164-a2cd-364592c15c6a",
                  "title": "No Record of Who Made Database Changes",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Repudiation",
                  "description": "The PostgreSQL database does not currently have query/change auditing enabled. If a record is altered or deleted, there is no way to determine which user, session, or process was responsible.",
                  "mitigation": "Enable PostgreSQL's logging options (log_statement, log_connections) or use an extension such as pgAudit to record who executed which queries and when. Ensure the Web Application always queries the database using distinct, traceable credentials per service rather than a single shared account.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                },
                {
                  "id": "ddca1242-7979-4036-82b6-98712d81528a",
                  "title": "Database Credentials and Data Exposed via Weak Configuration",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Information disclosure",
                  "description": "Database credentials (username/password) are currently stored in plaintext environment variables inside the Docker Compose files used in this assessment (e.g. POSTGRES_PASSWORD=nextcloud), rather than a secrets manager. If the compose file, container environment, or host is exposed, an attacker gains direct credentials to the database and could exfiltrate all stored data.",
                  "mitigation": "Use AWS Secrets Manager or Docker secrets to inject database credentials at runtime instead of hardcoding them in compose.yaml. Rotate credentials regularly. Ensure the database is never exposed on a published host port (use `expose` rather than `ports`, as already correctly done for the NextCloud db service) so it is reachable only from application containers on the same Docker network, never from the public internet.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 12,
                  "score": ""
                },
                {
                  "id": "756308cc-3372-452e-99e1-485c7aa7903b",
                  "title": "Database Overload from Unbounded Connections",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "The PostgreSQL container has no connection limit or resource constraints configured. A surge of connections from the Web Application (e.g. under load, or from a connection-leak bug) or a direct attack could exhaust the database's available connections/memory, denying service to legitimate application requests.",
                  "mitigation": "Set max_connections appropriately in PostgreSQL configuration and configure Docker resource limits (cpus, mem_limit) on the postgres service. Use connection pooling (e.g. pgBouncer) between the Web Application and the database. Ensure the healthcheck + service_healthy dependency pattern (already used in Task 3/4) is applied here too, so dependent services don't hammer the database with retries during startup or recovery.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 13,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "tampering": 1,
                "repudiation": 1,
                "informationDisclosure": 1,
                "denialOfService": 1
              }
            },
