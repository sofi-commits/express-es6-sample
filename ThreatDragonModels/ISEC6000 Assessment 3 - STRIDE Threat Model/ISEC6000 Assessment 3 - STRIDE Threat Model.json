            "data": {
              "type": "tm.Actor",
              "name": "User (Browser / UI)",
              "description": "",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "d09c984b-8c25-4d39-9d32-56d6be8a362d",
                  "title": "Identity Spoofing via Session Hijacking",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker intercepts or steals a user's session cookie/token (e.g. via network sniffing on an unencrypted connection, a cross-site scripting attack, or a man-in-the-middle attack) and impersonates the legitimate user to the Web Application, gaining unauthorized access to their session.",
                  "mitigation": "Enforce HTTPS/TLS for all traffic between the User and the Web Application (note: the current Elastic Beanstalk demo URL serves plain HTTP - production deployment should attach an SSL/TLS certificate via AWS Certificate Manager and an HTTPS listener on the load balancer). Use secure, HttpOnly, SameSite cookies for session tokens. Implement session expiry and token rotation.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "a7f533de-5e38-4414-be6d-cc30044b59dd",
                  "title": "User Denies Performing an Action",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "A user could deny having submitted a particular request to the Web Application, and without server-side logging there is no reliable record to prove or disprove the claim.",
                  "mitigation": "Implement server-side request logging on the Web Application (timestamp, source IP, session/user identifier, action performed). Use Elastic Beanstalk's environment logs / AWS CloudWatch Logs to maintain a non-repudiable audit trail of all requests reaching the application.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "repudiation": 1
              }
            }
