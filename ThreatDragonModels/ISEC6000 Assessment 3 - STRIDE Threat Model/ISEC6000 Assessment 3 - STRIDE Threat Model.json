            "data": {
              "type": "tm.Process",
              "name": "Web Application (Express.js on Elastic Beanstalk)",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "61f82980-2801-41ae-82d9-66658ff182dd",
                  "title": "Spoofed Requests to the Web Application",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "An attacker could send forged HTTP requests to the Web Application impersonating a legitimate client, or could spoof the application's own identity (e.g. a phishing site mimicking the Elastic Beanstalk domain) to trick users into sending credentials to a fake endpoint.",
                  "mitigation": "Serve the application over HTTPS/TLS with a valid certificate (via AWS Certificate Manager and a load balancer) so clients can verify the Web Application's identity. Avoid exposing the raw Elastic Beanstalk subdomain in production; use a custom domain with proper certificate pinning where possible.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "d5c034bb-0f8f-46bf-a4d1-1b86a18a24da",
                  "title": "Tampering with Request Data or Application Code",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker could tamper with HTTP request parameters/body in transit (if not using TLS) to inject malicious input into the Express route handlers, or could tamper with the deployed application artifact itself (e.g. compromising the CodePipeline build/deploy process to inject malicious code before it reaches Elastic Beanstalk).",
                  "mitigation": "Enforce HTTPS/TLS to protect data in transit. Apply input validation/sanitization on all route handlers (e.g. using express-validator). Restrict IAM permissions on the CodePipeline/CodeBuild service roles to least privilege, enable AWS CloudTrail logging on the pipeline, and require code review/branch protection on the GitHub repository before merges to the deployed branch.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "7cd734ce-0db8-47b6-922f-6a40d8cfbfd0",
                  "title": "Lack of Audit Trail for Application Actions",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "The Web Application currently has no application-level logging of requests or actions, so if a malicious or erroneous request occurs, there is no record to attribute it to a specific source or to reconstruct what happened.",
                  "mitigation": "Add structured request logging middleware (e.g. morgan, already a dependency in package.json) configured to write to a persistent, tamper-evident location. Forward Elastic Beanstalk/EC2 instance logs to AWS CloudWatch Logs with retention enabled, so logs survive instance termination and redeployment.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "895c1ebf-b556-45a8-bd01-fd2cfe04eb76",
                  "title": "Sensitive Data Exposure via Unencrypted Traffic or Error Messages",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "The deployed Elastic Beanstalk environment currently serves traffic over plain HTTP, so any data exchanged between the User and the Web Application (including future session tokens or form data) is visible to anyone who can observe the network path. Additionally, verbose Express error messages or stack traces could leak internal implementation details (file paths, dependency versions) to an attacker if NODE_ENV is not set to production correctly.",
                  "mitigation": "Enable HTTPS/TLS on the Elastic Beanstalk load balancer via AWS Certificate Manager. Ensure NODE_ENV=production is set so Express suppresses detailed stack traces in responses. Avoid returning raw error objects to clients; use a generic error-handling middleware that logs details server-side only.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "10e6de30-30fa-4171-bb12-5a90579adc40",
                  "title": "Resource Exhaustion on Single-Instance Environment",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "The Elastic Beanstalk environment is configured as a single-instance deployment with no auto-scaling or load balancer. A flood of requests (malicious or accidental) could exhaust the instance's CPU/memory/connections, making the application unavailable to legitimate users, with no redundant instance to take over.",
                  "mitigation": "Configure Elastic Beanstalk with an Auto Scaling group (minimum 2 instances) behind an Application Load Balancer instead of single-instance mode. Enable AWS Shield Standard (on by default) and consider AWS WAF rate-based rules to throttle abusive request patterns. Set appropriate request body size limits in Express to prevent oversized payload attacks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                },
                {
                  "id": "d18141a9-81bb-4c1a-80a2-6293b79a0926",
                  "title": "Overly Broad IAM Permissions on Pipeline/Deploy Roles",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "The CodePipeline service role currently has the broad AdministratorAccess-AWSElasticBeanstalk policy attached (applied to fix a permissions error during setup). If this role or its credentials were compromised, an attacker could use it to perform unauthorized actions across Elastic Beanstalk-related resources beyond what the pipeline strictly needs, effectively elevating privilege within the AWS account.",
                  "mitigation": "Replace the broad managed policy with a least-privilege custom IAM policy scoped only to the specific Elastic Beanstalk application/environment, CodeBuild project, and S3 artifact bucket this pipeline uses. Regularly audit IAM policies attached to service roles using AWS IAM Access Analyzer.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "tampering": 1,
                "repudiation": 1,
                "informationDisclosure": 1,
                "denialOfService": 1,
                "elevationOfPrivilege": 1
              }
            }
